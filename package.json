{
  "name": "worldfixture",
  "version": "0.2.7",
  "description": "Run a local software world and seed a connected application.",
  "keywords": [
    "fixture",
    "world",
    "simulation",
    "slack",
    "imap",
    "s3",
    "mcp",
    "testing",
    "demo"
  ],
  "license": "Apache-2.0",
  "author": "Benjamin Cates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ben-ic/worldfixture.git"
  },
  "homepage": "https://github.com/ben-ic/worldfixture#readme",
  "bugs": {
    "url": "https://github.com/ben-ic/worldfixture/issues"
  },
  "type": "module",
  "bin": {
    "worldfixture": "runtime/bin/worldfixture.mjs"
  },
  "scripts": {
    "worldfixture:local": "node runtime/bin/worldfixture.mjs",
    "test:coupling": "node tests/image/coupling-test.mjs",
    "test:coupling:unit": "node --test tests/image/coupling-*.test.mjs",
    "test:world-selection": "node tests/image/world-selection-test.mjs",
    "build:worlds": "python3 scripts/build-worlds.py",
    "build:workbench": "npm --prefix runtime/workbench-ui ci && npm --prefix runtime/workbench-ui run build",
    "docs:dev": "npm --prefix docs run dev",
    "docs:diagrams": "node scripts/render-architecture.mjs",
    "docs:diagrams:check": "node scripts/render-architecture.mjs --check",
    "postman:routes": "node scripts/build-postman-routes.mjs",
    "postman:routes:check": "node scripts/build-postman-routes.mjs --check",
    "docs:build": "npm --prefix docs run build",
    "docs:check": "node scripts/check-docs.mjs",
    "site:build": "WORLDFIXTURE_ANALYTICS=1 npm --prefix docs run build && WORLDFIXTURE_ANALYTICS=1 node scripts/build-site.mjs",
    "prepack": "npm run build:worlds && npm run build:workbench",
    "lint": "ruff check . && biome lint ."
  },
  "files": [
    "CHANGELOG.md",
    "NOTICE",
    "dist/",
    "docs/",
    "!docs/node_modules/",
    "!docs/.vitepress/",
    "!docs/package.json",
    "!docs/package-lock.json",
    "examples/minimal-world/",
    "examples/environments/",
    "examples/demo_app/package.json",
    "examples/demo_app/package-lock.json",
    "examples/demo_app/src/connector/",
    "examples/demo_app/src/db/",
    "examples/demo_app/src/providers/",
    "examples/demo_app/src/server/",
    "examples/demo_app/src/verification/",
    "examples/demo_app/src/workflows/",
    "examples/demo_app/dist/",
    "emulators/domain/src/validation.mjs",
    "emulators/emulate/src/plugins/gmail-delivery.mjs",
    "emulators/emulate/src/plugins/s3-signing.mjs",
    "emulators/emulate/src/oauth-client-config.mjs",
    "runtime/bin/",
    "runtime/src/",
    "!runtime/src/*.test.mjs",
    "runtime/workbench-ui/dist/",
    "schemas/",
    "skills/"
  ],
  "engines": {
    "node": ">=22"
  },
  "worldfixture": {
    "image": "ghcr.io/ben-ic/worldfixture:0.2.7"
  }
}
